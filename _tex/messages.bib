  volume = {11},
  number = {4},
  pages = {345--356},
  abstract = {Reports 3 studies with a total of 251 Ss (including members of intact families, nonprofessional employees, and psychiatric inpatients) investigating the reliability and validity of the McMaster Family Assessment Device (FAD) developed by the 2nd author et al (see record 1984-02891-001). Results indicate that the FAD has (a) adequate test-retest reliability, (b) low correlations with social desirability, (c) moderate correlations with other self-report measures of family functioning, and (d) the ability to differentiate significantly between clinician-rated healthy and unhealthy families. Cut-off scores for identifying healthy and unhealthy families were developed that have adequate sensitivity and specificity.}
