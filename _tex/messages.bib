  keywords = {*Alcohol Abuse,*Prediction,*Relapse (Disorders),*Risk Factors,*Systems Theory,Adult,Alcoholism,Female,Humans,Male,Mathematical Modeling,Nonlinear Dynamics,Recurrence,risk2_protocol_paper},
  file = {/Users/kendrawyant/Zotero/storage/J9RE83ZC/Hufford et al. - 2003 - Relapse as a nonlinear dynamic system Application.pdf}
}

