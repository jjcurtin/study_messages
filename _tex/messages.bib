@article{hungSmartphonebasedEcologicalMomentary2016a,
  title = {Smartphone-Based Ecological Momentary Assessment for {{Chinese}} Patients with Depression: {{An}} Exploratory Study in {{Taiwan}}},
  shorttitle = {Smartphone-Based Ecological Momentary Assessment for {{Chinese}} Patients with Depression},
  author = {Hung, Shan and Li, Min-Shan and Chen, Yen-Lin and Chiang, Jung-Hsien and Chen, Ying-Yeh and Hung, Galen Chin-Lun},
  year = {2016},
