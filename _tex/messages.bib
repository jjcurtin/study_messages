@article{marlattTaxonomyHighriskSituations1996a,
  title = {Taxonomy of High-Risk Situations for Alcohol Relapse: Evolution and Development of a},
  shorttitle = {Taxonomy of High-Risk Situations for Alcohol Relapse},
  author = {Marlatt, G. Alan},
  year = {1996},
