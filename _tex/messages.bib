@article{palmiusDetectingBipolarDepression2016,
  title = {Detecting {{Bipolar Depression From Geographic Location Data}}},
  author = {Palmius, Niclas and Tsanas, Athanasios and Saunders, Kate and Bilderbeck, Amy and Geddes, John and Goodwin, Guy and {de Vos}, Maarten},
